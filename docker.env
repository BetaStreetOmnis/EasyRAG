# EasyRAG Docker 环境配置文件

# 数据目录配置
DATA_DIR=./data

# 服务配置
API_HOST=0.0.0.0
API_PORT=8028
API_BASE_URL=http://localhost:8028

# Python 配置
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# 日志配置
LOG_LEVEL=INFO

# 联网检索（可选）：配置 You.com Search API Key 后，/web/search 端点即可作为
# 本地知识库之外的外部检索源；留空则该端点返回未启用提示，不影响其它功能。
# 获取 Key：https://you.com/platform/api-keys
YDC_API_KEY=
